{
  "name": "@dy-apps/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design tokens and the few components every app reuses (StyleX, TS source, no build step).",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.stylex": "./src/tokens.stylex.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@dy-apps/services": "workspace:*",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-virtual": "^3.14.13"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@dy-apps/config": "workspace:*",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
