{
  "name": "@dy-apps/chat-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Command-line bot: reads a live room's chat from room-feed and answers @mentions with `claude -p`.",
  "scripts": {
    "start": "tsx src/main.ts",
    "remember": "tsx src/remember.ts",
    "replay:song-breaks": "tsx scripts/song-breaks-replay.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest -c jest.config.js"
  },
  "dependencies": {
    "@dy-apps/lyrics-search": "workspace:*",
    "@dy-apps/room-feed-protocol": "workspace:*",
    "@dy-apps/room-memory": "workspace:*",
    "pinyin-pro": "3.29.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "jest": "^30.5.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
